{
  "base": "https://<your-subdomain>.retool.com",
  "page_uuid": "<page-uuid>",
  "thread_id": "<thread-uuid, только для session_mode=shared>",
  "cookie": "<cookies: accessToken + xsrfToken + cf_clearance>",
  "xsrf": "<xsrf token>",
  "ua": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.0.0 Safari/537.36",

  "host": "127.0.0.1",
  "port": 8787,
  "relay_api_key": "<optional; иначе env RELAY_API_KEY или сгенерированный relay_key.txt>",

  "session_mode": "per_conversation",
  "strict_models": true,
  "enable_responses": true,
  "enable_anthropic": true,

  "max_body_bytes": 33554432,
  "max_workers": 32,
  "max_conversations": 128,
  "conversation_idle_timeout": 900,
  "rate_limit_rps": 32,
  "rate_limit_burst": 64,
  "turn_timeout": 300,
  "recv_timeout": 120,
  "upstream_timeout": 120,
  "session_refresh_interval": 900,

  "model": "claude-opus-5-5",
  "provider_resource_name": "ffd4d570-7c6b-414f-b95a-1a695676d0a8",
  "openai_provider_resource_name": "1b7f4c97-241f-4117-a710-18c7cbfa74b1",
  "reasoning_effort": "high",

  "exec_policy": "allowlist",
  "exec_policy_note": "allowlist режет команду по \\n и \\u0026\\u0026 || | ; \\u0026 вне кавычек; тело powershell/cmd после -Command/-c проверяется рекурсивно",
  "exec_allowlist": ["^powershell\\b", "^pwsh\\b", "^cmd\\b", "^git\\b", "^dir\\b", "^type\\b", "^findstr\\b"],
  "max_exec_turns": 0,
  "command_timeout": 40,
  "command_output_limit": 64000,
  "show_exec_output": true,

  "project_context": true,
  "context_max_bytes": 120000,
  "max_prompt_bytes": 128000,
  "workspace_root": "C:\\your\\project\\path"
}
