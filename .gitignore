__pycache__/
*.pyc
*.pyo
*.pyd
*.bak
*.bak[._~-]*
*.backup
*.backup[._~-]*
*.log
*.log.[0-9]*
*.tmp
*.swp
*.orig
*.rej
.cache/
.mypy_cache/
.ruff_cache/
.venv/

# Private environment; versioned templates may contain placeholder values only.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# runtime secrets and state (keep config.example.json in git)
config.json
*.json.lock
*.json.auth-*.lock
cookies.txt
relay_key.txt
commands.log
relay.log
# the old relay.log files the supervisor keeps beside it (scripts/run_relay.ps1: .1 to .3)
relay.log.*
relay.pid
crash.log
journal.jsonl
# the old journal files the relay keeps beside it (journal_keep_files: .1 to .5 by default)
journal.jsonl.*
/conversations/
.session-*.tmp
.pytest_cache/
probes/chunks/

# Personal prompt control files: profiles, rules and the texts they read (prompts.example.json is the shared sample).
/prompts.json
/prompts/
# What saving prompts.json leaves beside it: the previous version and an interrupted write.
/prompts.json.bak
/.prompts-*.tmp

# Private investigation artifacts can contain captured upstream credentials.
.verify*/
/probes/
/r.txt
/logs/

# Frontend dependencies and generated source tokens (web/dist is shipped).
node_modules/
/web/src/tokens.css
test-results/
playwright-report/

# Local scratch work. Keep sensitive backups outside the checkout.
.tmp/
.agents/

# Editor and agent tool state of this machine
.zcode/
.claude/
.codex/

# A state folder for `python proxy.py --state-dir state` (journal, command log, conversations, upstream-400 dumps)
/state/

# What the relay measured of Minara (minara_refresh), Retool (retool_refresh) and universal providers (catalog.discovery)
/minara_models.auto.json
/retool_models.auto.json
/retool_plans.auto.json
/retool_plans.auto.json.bad
/provider_models.auto.json
/models_dev.cache.json
# What a client key spent on Minara today (cost_guard)
/cost_guard.auto.json
/cost_guard.auto.json.tmp
.minara-catalog-*.tmp
.retool-catalog-*.tmp
.retool-plans-*.tmp
.prov_models_*.tmp
.models_dev_*.tmp
