__pycache__/
*.pyc
*.pyo
*.pyd
*.bak
*.log
.ruff_cache/

# runtime secrets and state (keep config.example.json in git)
config.json
*.json.lock
*.json.auth-*.lock
cookies.txt
relay_key.txt
commands.log
relay.log
relay.pid
crash.log
journal.jsonl
# the old journal files the relay keeps beside it (journal_keep_files: .1 to .5 by default)
journal.jsonl.*
/conversations/
.session-*.tmp
.pytest_cache/
probes/chunks/

# Personal prompt control files: profiles, rules and the texts they read (prompts.example.json is the shared sample).
/prompts.json
/prompts/
# What saving prompts.json leaves beside it: the previous version and an interrupted write.
/prompts.json.bak
/.prompts-*.tmp

# Private investigation artifacts can contain captured upstream credentials.
.verify*/
/probes/
/r.txt
/logs/

# Frontend dependencies and generated source tokens (distribution is shipped).
/web/node_modules/
/web/src/tokens.css
/web/test-results/
/web/playwright-report/

# agent scratch work
.agents/

# Editor and agent tool state of this machine
.zcode/
.claude/worktrees/
.claude/settings.local.json

# A state folder for `python proxy.py --state-dir state` (journal, command log, conversations, upstream-400 dumps)
/state/
