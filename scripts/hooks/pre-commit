#!/bin/sh
# Run the same placement rules locally before Git creates the commit.
root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
# The shared Git config may also be used from a checkout of an older branch.
[ -f scripts/check_repo_hygiene.py ] || exit 0
exec python -B scripts/check_repo_hygiene.py --worktree
